# mypy: ignore-errors
# pylint: skip-file


@struct
class Array:

    val: i32

    @blue
    @classmethod
    def make_kernel(cls):

        @force_inline
        def inlined_kernel(arr: Array) -> i32:
            return arr.val

        return inlined_kernel


@blue.generic
def Lazy(EXPR_T):

    @struct
    class Self:
        expr: EXPR_T

        @blue
        @classmethod
        def make_kernel(cls):
            expr_kernel = EXPR_T.make_kernel()

            @force_inline
            def inlined_kernel(expr: Self) -> i32:
                return expr_kernel(expr.expr)

            return inlined_kernel

    return Self


def main() -> None:

    arr = Array(42)

    LazyArray = Lazy[Array]

    kernel = LazyArray.make_kernel()

    lazy_array = LazyArray(arr)

    print(kernel(lazy_array))
